# Copy this file to .env and replace every `*-with-a-long-random-value` below
# with a real random secret before starting the app. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start while any secret is empty or a known placeholder
# (including this file's values). Never commit .env — it is gitignored.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgresql://inventory:replace-me@127.0.0.1:5432/inventory

# JWT compatibility names retained from the MERN application.
# SimpleJWT uses ACCESS_TOKEN_SECRET as its signing key for both token types.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=legacy-variable-not-used-by-simplejwt
REFRESH_TOKEN_EXPIRY=1d
